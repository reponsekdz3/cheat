# Copy to .env and replace every secret before running outside a local workstation.
POSTGRES_DB=integrity
POSTGRES_USER=integrity_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://integrity_app:CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/integrity
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES_BEFORE_STARTING
ACCESS_TOKEN_MINUTES=15
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
